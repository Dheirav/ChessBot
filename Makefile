# Compiler and flags
CXX = g++
# -pthread is required: the engine runs its search on std::thread.
# -MMD -MP emit .d dependency files so editing a header rebuilds dependents.
CXXFLAGS = -std=c++17 -O2 -Wall -pthread -MMD -MP -I./src

# SFML libraries to link against
SFML_LIBS = -lsfml-graphics -lsfml-window -lsfml-system
LDFLAGS = -pthread

# Source files (automatically find all .cpp files in src/, src/engine/, and src/gui/)
SRC = $(wildcard src/*.cpp src/engine/*.cpp src/gui/*.cpp)

# Object and dependency files generated from source files
OBJ = $(SRC:.cpp=.o)
DEP = $(OBJ:.o=.d)

# Name of the final executable
EXEC = chessbot

# Default target: build the executable
all: $(EXEC)

# Link object files to create the executable
$(EXEC): $(OBJ)
	$(CXX) $(OBJ) -o $@ $(SFML_LIBS) $(LDFLAGS)

# Compile .cpp files to .o object files
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Header dependency tracking (generated by -MMD)
-include $(DEP)

# Clean up build files
clean:
	rm -f $(OBJ) $(DEP) $(EXEC)

# Clean and rebuild the project
remake:
	$(MAKE) clean
	$(MAKE) all

# Mark these targets as not actual files
.PHONY: all clean remake
