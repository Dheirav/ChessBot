# Build artifacts
*.o
*.d
chessbot

# Test binaries (built by `make tests`). Listed as a pattern rather than by
# name: the by-name version silently failed to cover four binaries added later,
# and `git add -A` committed them. Sources and fixtures are re-included below.
tests/*
!tests/*.cpp
!tests/*.py
!tests/data/

# Move lookup tables are cached next to whichever binary generated them
lookup_data/
tests/src/

# Profiling and logs
gmon.out
evaluation_log_*.txt

# Match gate logs (tee output, often still being written)
gate-*.log
