# Local agent instructions. Deliberately untracked: HANDOFF.md and the READMEs
# are the shared, reviewable docs, and this one is a per-machine convenience
# that would otherwise drift from them without anyone reviewing it.
CLAUDE.md

# Build artifacts
*.o
*.d
chessbot

# Test binaries (built by `make tests`). Listed as a pattern rather than by
# name: the by-name version silently failed to cover four binaries added later,
# and `git add -A` committed them. Sources and fixtures are re-included below.
tests/*
!tests/*.cpp
!tests/*.hpp
!tests/*.py
!tests/*.sh
!tests/*.md
!tests/data/

# Move lookup tables are cached next to whichever binary generated them
lookup_data/
tests/src/

# Profiling and logs
gmon.out
evaluation_log_*.txt

# Match gate logs (tee output, often still being written)
gate-*.log
gates-all.log
# Per-shard logs from tests/shard-gate.sh
shard-*/

# Games saved from the GUI with Ctrl+S
games/
tools/*.o
tools/*.d
tools/review
tools/tune
# Generated Texel corpora. Regenerate with tools/texel-corpus.py --split; they
# are derived from the game archive, which lives outside this repo, so a
# committed copy would be a snapshot claiming to be the corpus.
tests/data/texel.epd
tests/data/texel.test.epd
tests/data/texel.sf.epd
tests/data/texel.test.sf.epd

# Public Texel corpus (zurichess, BSD-3) and its splits -- fetched, not ours
tests/data/quiet-labeled.epd
tests/data/ql.*.epd
tests/data/own-archive.epd
